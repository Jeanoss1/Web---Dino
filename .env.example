# ==============================================================================
# Dino Park - Variables de Entorno de Ejemplo
# Copia este archivo a `.env` y configura los valores correspondientes a tu entorno.
# ==============================================================================

# --- Base de Datos PostgreSQL ---
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
DATABASE_URL=postgresql://postgres:root@localhost:5432/dino_park_db

# (Opcional) Base de datos dedicada para pruebas automatizadas (tests/test_casos.py).
# Si no se define, el motor usará el mismo host de DATABASE_URL cambiando el nombre a dino_park_pruebas.
PRUEBAS_DATABASE_URL=postgresql://postgres:root@localhost:5432/dino_park_pruebas

# Conexiones simultáneas al pool de PostgreSQL
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# --- Seguridad y Sesiones ---
# Clave secreta para cookies de sesión y tokens de protección CSRF (Flask-WTF).
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_secreta_segura_de_32_bytes

# --- Servidor de Producción (Waitress - servidor.py) ---
PUERTO=8000
HILOS=32

# --- Autenticación con Google (OAuth 2.0) ---
# Obtén estas credenciales en Google Cloud Console > APIs & Services > Credentials.
# Si se dejan vacías, el botón de "Iniciar sesión con Google" se desactivará automáticamente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# (Opcional) Forzar URL de redirección HTTPS detrás de proxy inverso:
# GOOGLE_REDIRECT_URI=https://tudominio.railway.app/auth/google/callback

# --- Usuario Cajero Inicial (Sembrado de datos - app/seed.py) ---
# Credenciales usadas para crear el primer cajero operativo al iniciar la aplicación.
CAJERO_CORREO=cajero@dinopark.pe
CAJERO_CONTRASENA=Cajero2026!

# --- Almacenamiento de Archivos en la Nube (Comprobantes de Pago) ---
# Opciones para STORAGE_PROVIDER: 'local', 's3' (o 'r2'), 'cloudinary'.
# Si no se define, se detecta automáticamente según las credenciales presentes.
# Si no se define ninguna credencial, se guardará en disco local (uploads/comprobantes).
STORAGE_PROVIDER=

# Opción A: Cloudinary (Inicio rápido y sencillo)
# Formato de URL completa: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# O mediante variables individuales:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Opción B: AWS S3 o Cloudflare R2 (Recomendado en producción / contenedores Railway)
# Para Cloudflare R2: S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# Para AWS S3 estándar: dejar S3_ENDPOINT_URL vacío o comentar la línea.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_ENDPOINT_URL=
# (Opcional) Dominio público o CDN para servir comprobantes directamente (ej: https://cdn.dinopark.pe):
S3_PUBLIC_DOMAIN=
# (Opcional) Expiración en segundos para URLs prefirmadas privadas (por defecto: 900 = 15 minutos):
S3_URL_EXPIRACION=900

