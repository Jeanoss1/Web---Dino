# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a git.

# development | production
APP_ENV=development

# Clave para firmar las sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Cadena de conexión a PostgreSQL
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/dino_park_db

# Número de Yape del negocio (9 dígitos) que ven los clientes
YAPE_NUMERO=999999999

# Cookies solo por HTTPS (poner 1 en producción)
SESSION_COOKIE_SECURE=0

# Contraseña de las cuentas de prueba que crea "flask seed"
SEED_PASSWORD=CambiaEstaClave1

# Opcionales (valores por defecto entre paréntesis)
# HORA_APERTURA=10:00
# HORA_CIERRE=22:00
# DIAS_ANTICIPACION=14
# MINUTOS_LIMITE_PAGO=15
# TOLERANCIA_MINUTOS=2
# UPLOAD_FOLDER=uploads/comprobantes
